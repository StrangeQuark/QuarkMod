{
	"schemaVersion": 1,
	"id": "quarkmod",
	"version": "${version}",
	"name": "QuarkMod",
	"description": "The complete QuarkMod bundle, including Grappling, Excavator, Loot Tweaks, Large Villages, and the Dream Dimension.",
	"authors": [
		"StrangeQuark"
	],
	"contact": {
		"homepage": "https://github.com/StrangeQuark/quarkmod",
		"sources": "https://github.com/StrangeQuark/quarkmod"
	},
	"license": "CC0-1.0",
	"icon": "assets/quarkmod/icon.png",
	"environment": "*",
	"jars": [
		{
			"file": "META-INF/jars/quarkmod-grappling-${version}.jar"
		},
		{
			"file": "META-INF/jars/quarkmod-excavator-${version}.jar"
		},
		{
			"file": "META-INF/jars/quarkmod-loot-tweaks-${version}.jar"
		},
		{
			"file": "META-INF/jars/quarkmod-large-villages-${version}.jar"
		},
