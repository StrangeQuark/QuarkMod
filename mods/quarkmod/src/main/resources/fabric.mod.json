			"file": "META-INF/jars/quarkmod-dream-dimension-${version}.jar"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*",
		"quarkmod_grappling": "*",
		"quarkmod_excavator": "*",
		"quarkmod_loot_tweaks": "*",
		"quarkmod_large_villages": "*",
		"quarkmod_dream_dimension": "*"
